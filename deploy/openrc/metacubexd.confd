# /etc/conf.d/metacubexd — OpenRC environment variables
#
# This file is sourced by /etc/init.d/metacubexd before starting the service.
# All variables are exported so they reach the metacubexd-server process.
#
# For a full list of variables and their defaults, see README.md § 配置 > 环境变量.
#
# Defaults are provided by the init script; only set values you need to change.

# ── User / Group ──────────────────────────────────────────────────────────
export METACUBEXD_USER="metacubexd:metacubexd"

# ── Paths ─────────────────────────────────────────────────────────────────
export MIHOMO_BIN="/usr/local/bin/mihomo"
export DATA_DIR="/var/lib/metacubexd"

# ── Secrets (recommended for production) ──────────────────────────────────
# Generate random strings with: openssl rand -hex 16
export CONTROL_TOKEN=""
export CLASH_SECRET=""

# ── Optional ──────────────────────────────────────────────────────────────
# export CONTROL_PORT=8080
# export MIXED_PORT=7890
# export TZ="Asia/Shanghai"
