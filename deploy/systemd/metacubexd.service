[Unit]
Description=metacubexd-server (All-in-One dashboard + mihomo supervisor)
Documentation=https://github.com/Sion10032/metacubexd-server-go
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=metacubexd
Group=metacubexd

# Environment overrides — the .env file is optional (missing = no error).
# Only put secrets or non-default values here; everything else is in [Service].
EnvironmentFile=-/etc/metacubexd/metacubexd.env

# Base env that almost every deployment needs.
# DATA_DIR is also managed by StateDirectory= below; both point to the same
# path so the process always sees /var/lib/metacubexd regardless of how it
# was started.
Environment=DATA_DIR=/var/lib/metacubexd
Environment=MIHOMO_BIN=/usr/local/bin/mihomo

ExecStart=/usr/local/bin/metacubexd-server

# ── Graceful shutdown ─────────────────────────────────────────────────────
# main.go handles SIGTERM: srv.Shutdown (10 s) → sched.Stop → sup.Dispose → bye.
# Give it 15 s to finish before SIGKILL.
TimeoutStopSec=15
KillSignal=SIGTERM

# ── Crash recovery ────────────────────────────────────────────────────────
Restart=on-failure
RestartSec=5

# ── TUN capability (mihomo needs CAP_NET_ADMIN to create /dev/net/tun) ───
# AmbientCapabilities is the cleanest systemd way to give a non-root service
# a capability while keeping the bounding set narrow.  mihomo (child process)
# inherits the ambient set.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true

# ── File-system sandboxing ───────────────────────────────────────────────
# StateDirectory= automatically creates /var/lib/metacubexd owned by User=
StateDirectory=metacubexd
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# Allow mihomo to access the TUN device (usually 0666, but be explicit).
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
