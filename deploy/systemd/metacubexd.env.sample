# ── metacubexd-server env ──────────────────────────────────────────────────
# Copy to /etc/metacubexd/metacubexd.env and edit as needed.
# Only non-default values need to be set; everything else uses built-in defaults.
#
# For a full list of variables and their defaults, see README.md § 配置 > 环境变量.
#
# Variables marked [unit-fixed] are already set in metacubexd.service and
# should NOT be duplicated here unless you need to override them.

# ── Secrets (recommended for production) ──────────────────────────────────
# CONTROL_TOKEN gates the login page and /api/control/* Bearer auth.
# CLASH_SECRET is mihomo's external-controller secret (for cross-origin access).
# Generate random strings with: openssl rand -hex 16
CONTROL_TOKEN=
CLASH_SECRET=

# ── Ports ─────────────────────────────────────────────────────────────────
# CONTROL_PORT=8080              # Dashboard + API listen port
# CLASH_API_PORT=9090            # mihomo Clash API port (internal)
# MIXED_PORT=7890                # mihomo mixed proxy port

# ── Paths (rarely need to change) ────────────────────────────────────────
# DATA_DIR=/var/lib/metacubexd   # [unit-fixed] profiles, active.yaml, geo cache
# MIHOMO_BIN=/usr/local/bin/mihomo

# ── Optional ──────────────────────────────────────────────────────────────
# TZ=Asia/Shanghai               # IANA timezone, e.g. Asia/Shanghai
# GITHUB_TOKEN=                  # Authenticated GitHub rate limits (optional)
# UI_DIST=                       # Override embedded UI with external dist dir
